start: s
accept: ac
reject: rj 
blank: _

s 0 -> begin 0 >
s 1 -> begin 1 >
s _ -> s _ ^

begin 0 -> begin 0 >
begin 1 -> begin 1 >
begin _ -> back _ <
begin A -> begin A >  
begin B -> begin B >  

back 0 -> write0 A >
back 1 -> write1 B >
back A -> back 0 <
back B -> back 1 <
back _ -> end _ ^
back X -> back X < 

write0 1 -> write0 B >
write0 0 -> write0 A >
write0 _ -> back 0 <
write0 X -> write0 X >  

write1 0 -> write1 A >
write1 1 -> write1 B >
write1 _ -> back 1 <
write1 Y -> write1 Y < 

end _ -> ac _ >
end 0 -> end 0 >  
end 1 -> end 1 > 